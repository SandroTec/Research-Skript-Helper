# Copy to .env. Never commit .env or place this key in Angular/browser code.
OPENAI_API_KEY=
LOCAL_API_TOKEN=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_FAST=gpt-6-luna
OPENAI_MODEL_WRITING=gpt-6.1-terra
OPENAI_MODEL_RESEARCH=gpt-6.1-sol
OPENAI_MODEL_REVIEW=gpt-6-luna
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:4200
MAX_CONCURRENT_JOBS=1
MONTHLY_BUDGET_USD=50
MAX_WEB_SEARCH_CALLS_PER_JOB=3
# OpenAI hosted web search currently costs $10 per 1,000 search calls.
WEB_SEARCH_USD_PER_1000_CALLS=10
# Enter current per-million-token prices for each configured model. Empty rates block calls.
OPENAI_FAST_INPUT_USD_PER_MILLION=
OPENAI_FAST_OUTPUT_USD_PER_MILLION=
OPENAI_WRITING_INPUT_USD_PER_MILLION=
OPENAI_WRITING_OUTPUT_USD_PER_MILLION=
OPENAI_RESEARCH_INPUT_USD_PER_MILLION=
OPENAI_RESEARCH_OUTPUT_USD_PER_MILLION=
OPENAI_REVIEW_INPUT_USD_PER_MILLION=
OPENAI_REVIEW_OUTPUT_USD_PER_MILLION=
MAX_OUTPUT_TOKENS=6000
